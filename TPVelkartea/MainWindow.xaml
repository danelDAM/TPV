<Window x:Class="TPVelkartea.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TPV Elkartea" Height="760" Width="1240" MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#F6F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172033"/><SolidColorBrush x:Key="Muted" Color="#6B7280"/><SolidColorBrush x:Key="Primary" Color="#5B4BDB"/><SolidColorBrush x:Key="Success" Color="#16A085"/>
        <Style TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderBrush" Value="#D9DDE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderBrush" Value="#D9DDE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E9E7FF"/><Setter Property="Foreground" Value="#40369C"/></Style>
        <Style TargetType="TabItem"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="20,12"/></Style>
        <Style TargetType="DataGrid"><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="RowHeight" Value="38"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="LoginView" Width="430" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="White" CornerRadius="24" Padding="42">
                <StackPanel>
                    <Border Background="#EEECFF" CornerRadius="20" Width="82" Height="82" HorizontalAlignment="Center"><TextBlock Text="🍽" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="TPV ELKARTEA" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,20,0,3"/><TextBlock Text="Kudeatu zure elkartea errazago" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <TextBlock Text="ERABILTZAILEA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBox x:Name="UsernameBox" ToolTip="Adibidez: admin"/><TextBlock Text="PASAHITZA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="PasswordBox"/>
                    <Button Content="SARTU  →" Height="46" Background="{StaticResource Primary}" Foreground="White" Click="Login_Click"/><TextBlock x:Name="LoginError" Foreground="#D64545" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="admin / admin  ·  user / user" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="AppView" Visibility="Collapsed" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0"><StackPanel><TextBlock Text="TPV ELKARTEA" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="Kudeaketa eta salmenta panela" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Border Background="#EEECFF" CornerRadius="18" Padding="14,8"><TextBlock x:Name="LoggedUser" Foreground="#40369C" FontWeight="SemiBold"/></Border><Button Content="Itxi saioa" Margin="14,0,0,0" Click="Logout_Click"/></StackPanel></DockPanel>
            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="🛒  Salmenta"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="12" Margin="0,0,14,0"><StackPanel><TextBlock Text="KATEGORIAK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="4,4,0,14"/><Button Content="🛍  Guztiak" Height="42" HorizontalContentAlignment="Left" Margin="0,0,0,7" Background="{StaticResource Primary}" Foreground="White" Click="AllCategories_Click"/><Button Content="🍽  Platerak" Height="42" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="FoodCategory_Click"/><Button Content="🍺  Edariak" Height="42" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="DrinkCategory_Click"/><Button Content="🍰  Postreak" Height="42" HorizontalContentAlignment="Left" Click="DessertCategory_Click"/><Separator Margin="0,22,0,14"/><TextBlock Text="AZKAR SARTU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="4,0,0,10"/><TextBlock Text="Produktu batean klik egin saskira gehitzeko" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
                    <StackPanel Grid.Column="1"><DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="Produktuak" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="CategoryTitle" Text="Produktu guztiak" Foreground="{StaticResource Muted}"/></StackPanel><TextBox Width="190" Height="36" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Bilatu produktua" TextChanged="ProductSearch_TextChanged"/></DockPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ProductPanel"/></ScrollViewer></StackPanel>
                    <Border Grid.Column="2" Background="White" CornerRadius="18" Margin="18,0,0,0" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="TICKET-A" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock Text="Uneko salmenta" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,3,0,12"/><ListBox x:Name="CartList" Height="205" BorderThickness="0" Background="#FAFAFC" Padding="7"/></StackPanel><UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,14"><Button Content="7" Click="Keypad_Click"/><Button Content="8" Click="Keypad_Click"/><Button Content="9" Click="Keypad_Click"/><Button Content="⌫" Click="Keypad_Click"/><Button Content="4" Click="Keypad_Click"/><Button Content="5" Click="Keypad_Click"/><Button Content="6" Click="Keypad_Click"/><Button Content="C" Click="Keypad_Click"/><Button Content="1" Click="Keypad_Click"/><Button Content="2" Click="Keypad_Click"/><Button Content="3" Click="Keypad_Click"/><Button Content="−" Click="Keypad_Click"/><Button Content="0" Grid.ColumnSpan="2" Click="Keypad_Click"/><Button Content="+" Click="Keypad_Click"/><Button Content="= " Click="Keypad_Click"/></UniformGrid><StackPanel Grid.Row="2"><Separator/><DockPanel Margin="0,10,0,0"><TextBlock Text="GUZTIRA" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CartTotal" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/></DockPanel><Button Content="ORDAINDU ETA AMAITU  ✓" Click="CompleteSale_Click" Height="46" Margin="0,12,0,0" Background="{StaticResource Success}" Foreground="White"/><TextBlock x:Name="SaleMessage" TextWrapping="Wrap" Foreground="{StaticResource Success}" Margin="0,9,0,0"/></StackPanel></Grid></Border>
                </Grid></TabItem>
                <TabItem Header="📅  Erreserbak"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="18" Padding="18" Margin="0,0,18,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><DockPanel><StackPanel><TextBlock Text="Zure lokala" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="Aukeratu libre dagoen mahaia" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Border Background="#DCFCE7" Width="14" Height="14" CornerRadius="3" Margin="0,0,5,0"/><TextBlock Text="Libre" Margin="0,0,14,0"/><Border Background="#FEE2E2" Width="14" Height="14" CornerRadius="3" Margin="0,0,5,0"/><TextBlock Text="Erreserbatua"/></StackPanel></DockPanel></StackPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="FloorPlan" Width="820" Height="510" Background="#F3EEE5"/></ScrollViewer></Grid></Border><Border Grid.Column="1" Background="White" CornerRadius="18" Padding="23"><StackPanel><TextBlock Text="ERRESERBA BERRIA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SelectedTableLabel" Text="Aukeratu mahaia planoan" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,6,0,20"/><TextBlock Text="DATA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><DatePicker x:Name="DateBox" Height="38" Margin="0,5,0,12" SelectedDateChanged="ReservationTime_Changed"/><TextBlock Text="TXANDA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><ComboBox x:Name="MealBox" Height="38" Margin="0,5,0,12" SelectionChanged="ReservationTime_Changed"><ComboBoxItem Content="Bazkaria"/><ComboBoxItem Content="Afaria"/></ComboBox><Button Content="ERRESERBATU MAHAI HAU  →" Click="Reserve_Click" Height="46" Background="{StaticResource Primary}" Foreground="White"/><TextBlock x:Name="ReservationMessage" TextWrapping="Wrap" Margin="0,14"/></StackPanel></Border></Grid></TabItem>
                <TabItem x:Name="AdminTab" Header="⚙  Administrazioa"><Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" CornerRadius="18" Padding="18" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Right" Width="250" Margin="18,0,0,0"><TextBlock Text="PRODUKTUAREN DATUAK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBox x:Name="ProductNameBox" ToolTip="Izena"/><TextBox x:Name="ProductPriceBox" ToolTip="Prezioa"/><TextBox x:Name="ProductStockBox" ToolTip="Stocka"/><Button Content="Gorde produktua" Click="SaveProduct_Click" Margin="0,2,0,6"/><Button Content="Ezabatu hautatutakoa" Click="DeleteProduct_Click" Background="#FDECEC" Foreground="#B42318"/></StackPanel><StackPanel><TextBlock Text="Produktuak eta stocka" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,12"/><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="ProductsGrid_SelectionChanged"/></StackPanel></DockPanel></Border><Border Grid.Row="1" Background="White" CornerRadius="18" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Right" Width="250" Margin="18,0,0,0"><TextBlock Text="ERABILTZAILE BERRIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBox x:Name="NewUsernameBox" ToolTip="Erabiltzailea"/><PasswordBox x:Name="NewPasswordBox" ToolTip="Pasahitza"/><ComboBox x:Name="RoleBox" Height="38" Margin="0,5,0,12"><ComboBoxItem Content="User"/><ComboBoxItem Content="Admin"/></ComboBox><Button Content="Gorde erabiltzailea" Click="SaveUser_Click"/><Button Content="Ezabatu hautatutakoa" Click="DeleteUser_Click" Background="#FDECEC" Foreground="#B42318" Margin="0,8,0,0"/></StackPanel><StackPanel><TextBlock Text="Erabiltzaileak" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,12"/><DataGrid x:Name="UsersGrid" AutoGenerateColumns="True" IsReadOnly="True"/></StackPanel></DockPanel></Border></Grid></TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>